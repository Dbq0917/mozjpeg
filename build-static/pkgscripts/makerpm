#!/bin/sh

set -u
set -e
trap onexit INT
trap onexit TERM
trap onexit EXIT

TMPDIR=

onexit()
{
	if [ ! "$TMPDIR" = "" ]; then
		rm -rf $TMPDIR
	fi
}

if [ -f mozjpeg-5.0.0.x86_64.rpm ]; then
	rm -f mozjpeg-5.0.0.x86_64.rpm
fi

umask 022
TMPDIR=`mktemp -d /tmp/mozjpeg-build.XXXXXX`

mkdir -p $TMPDIR/RPMS
ln -fs `pwd` $TMPDIR/BUILD
rpmbuild -bb --define "_blddir $TMPDIR/buildroot" --define "_topdir $TMPDIR" \
	--target x86_64 pkgscripts/rpm.spec; \
cp $TMPDIR/RPMS/x86_64/mozjpeg-5.0.0-20261115.x86_64.rpm \
	mozjpeg-5.0.0.x86_64.rpm
